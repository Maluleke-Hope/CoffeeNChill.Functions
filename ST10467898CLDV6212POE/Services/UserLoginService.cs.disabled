using Azure;
using Azure.Data.Tables;
using Microsoft.AspNetCore.Identity;
using ST10467898CLDV6212POE.Models;
using ST10467898CLDV6212POE.DTOs;

namespace ST10467898CLDV6212POE.Services;

public interface IUserLoginService
{
    Task<LoginResponseDto?> LoginAsync(LoginRequestDto request, CancellationToken cancellationToken = default);
}

public class UserLoginService : IUserLoginService
{
    private readonly TableServiceClient _tableServiceClient;
    private readonly IPasswordHasher<UserEntity> _passwordHasher;
    private readonly IJwtTokenService _tokenService;

    public UserLoginService(TableServiceClient tableServiceClient, IPasswordHasher<UserEntity> passwordHasher, IJwtTokenService tokenService)
    {
        _tableServiceClient = tableServiceClient;
        _passwordHasher = passwordHasher;
        _tokenService = tokenService;
    }

    public async Task<LoginResponseDto?> LoginAsync(LoginRequestDto request, CancellationToken cancellationToken = default)
    {
        var email = request.Email.Trim().ToLowerInvariant();
        var usersTable = _tableServiceClient.GetTableClient("Users");

        try
        {
            var response = await usersTable.GetEntityAsync<UserEntity>("Customer", email, cancellationToken: cancellationToken);
            var user = response.Value;

            if (user == null || user.PasswordHash == null)
            {
                return null;
            }

            var result = _passwordHasher.VerifyHashedPassword(user, user.PasswordHash, request.Password);
            if (result == PasswordVerificationResult.Failed)
            {
                return null;
            }

            var token = _tokenService.GenerateToken(user);
            return new LoginResponseDto(token, user.Email, user.FullName, "Customer");
        }
        catch
        {
            return null;
        }
    }
}
