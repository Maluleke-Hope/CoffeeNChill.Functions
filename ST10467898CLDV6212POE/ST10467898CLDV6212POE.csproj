<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<AzureFunctionsVersion>v4</AzureFunctionsVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>

		<!-- Azure Table Storage -->
		<PackageReference Include="Azure.Data.Tables" Version="12.12.0" />

		<!-- Azure File Share Storage -->
		<PackageReference Include="Azure.Storage.Files.Shares" Version="12.27.1" />

		<!-- Azure Queue Storage for Part 2 -->
		<PackageReference Include="Azure.Storage.Queues" Version="12.27.1" />

		<!-- Application Insights -->
		<PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="3.1.2" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />

		<!-- Azure Functions .NET Isolated Worker -->
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />

		<!-- HTTP Functions -->
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />

		<!-- Azure Storage Functions -->
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage" Version="6.8.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

	</ItemGroup>

	<ItemGroup>

		<!-- Project folders -->
		<Folder Include="Configuration\" />
		<Folder Include="Extensions\" />
		<Folder Include="Helpers\" />
		<Folder Include="Interfaces\" />
		<Folder Include="Models\" />
		<Folder Include="Services\" />

	</ItemGroup>

</Project>