  "item": [
    {
      "name": "Get data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\npm.test(\"Order successfully queued - HTTP 202\", function () {\n    pm.response.to.have.status(202);\n});\n\npm.test(\"Response contains valid order ID\", function () {\n    const response = pm.response.json();\n    pm.expect(response.orderId).to.be.a(\"string\").and.not.empty;\n});\n\npm.test(\"Order status is Received\", function () {\n    const response = pm.response.json();\n    pm.expect(response.status).to.eql(\"Received\");\n});\n\npm.test(\"Customer ID matches request\", function () {\n    const response = pm.response.json();\n    pm.expect(response.customerId).to.eql(\"CUST-001\");\n});\n\npm.test(\"Response contains a timestamp\", function () {\n    const response = pm.response.json();\n    pm.expect(response.timestamp).to.be.a(\"string\");\n});\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"customerId\": \"CUST-001\",\r\n  \"items\": [\r\n    {\r\n      \"sku\": \"COF-001\",\r\n      \"quantity\": 2\r\n    }\r\n  ]\r\n}\r\n",
